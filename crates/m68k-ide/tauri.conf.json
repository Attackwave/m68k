{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "m68k-studio",
  "version": "2.2.0",
  "identifier": "com.attackwave.m68k-studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "./dist"
  },
  "app": {
    "windows": [
      {
        "title": "m68k Studio IDE",
        "width": 1440,
        "height": 920,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "opener": {},
    "dialog": {},
    "fs": {}
  }
}
